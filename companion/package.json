{
  "name": "ai-agent-companion",
  "version": "1.1.0",
  "description": "AI Agent Companion — เข้าถึงไฟล์ในเครื่องตัวเอง, ใช้ AI ผ่าน server (token กลาง)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.charoenlap.aiagent",
    "productName": "AI Agent",
    "files": ["main.js", "index.html", "package.json", "tts.js"],
    "directories": { "output": "release" },
    "publish": [{ "provider": "generic", "url": "https://ai.charoenlap.com/downloads/" }],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ],
      "artifactName": "AI-Agent-mac.${ext}"
    },
    "win": { "target": "nsis", "artifactName": "AI-Agent-win-setup.${ext}" },
    "nsis": { "oneClick": true, "perMachine": false }
  }
}
